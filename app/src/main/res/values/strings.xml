    <string name="accessibility_service_label">TimeHUD App Control</string>
    <string name="accessibility_service_description">Applies Brick Mode and app limits to visible launchable apps while leaving protected apps, background services, and allowed pop-up windows usable. Navigation state is processed locally.</string>
    <string name="app_blocking_heading">App limits</string>
    <string name="app_blocking_description">Set daily limits for apps or block selected sections in supported social and video apps. Closing a blocked check-in returns you Home.</string>
    <string name="app_blocking_access_title">App-control service</string>
    <string name="app_blocking_access_description">Required to apply Brick Mode and app limits to visible windows while preserving allowed pop-ups.</string>
    <string name="app_blocking_enable_access">Enable App Control</string>
    <string name="app_blocking_disclosure_title">Allow TimeHUD to control visible apps?</string>
    <string name="app_blocking_disclosure_message">To enforce Brick Mode and app-limit rules, TimeHUD’s accessibility service reads visible app package names, window names, navigation labels, view identifiers, editable-field state, focus, position, and size. It uses this information locally to allow chosen and essential apps, recognize supported sections, distinguish an open Instagram chat from the inbox, measure focused use, draw the TimeHUD check-in, and return Home when you close a blocked check-in. TimeHUD does not stop background services or store or transmit message bodies, captions, usernames, or screen contents. Android will show the final enable switch next.</string>
    <string name="app_blocking_disclosure_continue">Continue to Android Settings</string>
